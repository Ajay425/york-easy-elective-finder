<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title><%= title %></title>
    <style>
      :root{ --bg:#f7f8fb; --card:#fff; --muted:#6b7280; --accent:#2b6cb0 }
      body{font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background:var(--bg); margin:0; padding:24px}
      .container{max-width:1100px;margin:0 auto}
      h1{font-size:20px;margin:0 0 12px}
      .search-bar{display:flex;gap:10px;align-items:center;margin-bottom:18px}
      .search-input{flex:1;padding:10px 12px;border:1px solid #e6edf8;border-radius:8px;background:#fff}
      .btn{padding:9px 12px;border-radius:8px;border:1px solid transparent;cursor:pointer}
      .btn-primary{background:var(--accent);color:#fff}
      .results-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px}
      .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(16,24,40,0.04);border:1px solid #edf2f9;display:flex;flex-direction:column;gap:12px}
      .code-badge{display:inline-block;background:#eef6ff;color:var(--accent);font-weight:700;padding:6px 8px;border-radius:6px}
      .card-title{font-weight:700;margin-top:2px;font-size:15px}
      .meta{color:var(--muted);font-size:13px}
      .small{color:var(--muted);font-size:13px}
      .pager{margin-top:18px;display:flex;align-items:center;gap:12px}
      .pager button{padding:6px 10px;border-radius:8px;border:1px solid #e6edf8;background:#fff;cursor:pointer}
      .top-pop{margin-left:auto;color:#111;font-weight:600}
      .no-results{color:var(--muted)}
      @media (max-width:640px){.search-bar{flex-direction:column;align-items:stretch}.top-pop{margin-left:0}}
    </style>
  </head>
  <body>
    <div class="container">
      <div style="display:flex;align-items:center;gap:12px;justify-content:space-between">
        <h1 style="margin:0">Course Admin — Search</h1>
        <div><a href="/admin/logout" style="color:#2b6cb0;text-decoration:none">Logout</a></div>
      </div>
      <div class="search-bar">
        <input id="q" class="search-input" placeholder="Search by name, dept (EECS), code (2101) or faculty" />
        <button id="go" class="btn btn-primary">Search</button>
      </div>

      <div id="results" class="results-grid"></div>
      <div id="pager" class="pager"></div>
    </div>

    <script>
      const qInput = document.getElementById('q');
      const results = document.getElementById('results');
      const pager = document.getElementById('pager');
      const go = document.getElementById('go');
      go.addEventListener('click', ()=> renderPage(1));
      qInput.addEventListener('keydown', (e)=>{ if (e.key === 'Enter') renderPage(1) });

      let currentPage = 1; const pageSize = 20;

      function createCard(it){
        const el = document.createElement('div'); el.className = 'card';
        const header = document.createElement('div'); header.style.display = 'flex'; header.style.alignItems='center';
        const badge = document.createElement('div'); badge.className='code-badge'; badge.textContent = it.code || '';
        const title = document.createElement('div'); title.style.marginLeft='10px';
        title.innerHTML = `<div class='card-title'>${it.title || 'Untitled'}</div><div class='meta'>${it.faculty || ''}</div>`;
        header.appendChild(badge); header.appendChild(title);
        el.appendChild(header);

        const mid = document.createElement('div'); mid.className='meta'; mid.textContent = `Credits: ${it.credit ?? '—'}`;
        el.appendChild(mid);

        const foot = document.createElement('div'); foot.style.display='flex'; foot.style.alignItems='center';
        const open = document.createElement('button'); open.className='btn'; open.textContent='Open';
        open.addEventListener('click', ()=> window.location = `/admin/course/${it.id}`);
        foot.appendChild(open);
        el.appendChild(foot);

        return el;
      }

      async function renderPage(page){
        const q = qInput.value.trim();
        if (!q) { results.innerHTML = '<div class="no-results">Type something to search.</div>'; pager.innerHTML=''; return }
        results.innerHTML = '<div class="no-results">Searching…</div>'; pager.innerHTML='';
        try{
          const res = await fetch(`/courses/search?q=${encodeURIComponent(q)}&page=${page}&pageSize=${pageSize}`);
          const json = await res.json();
          const list = json.results || []; const total = json.total || 0; currentPage = json.page || page;
          results.innerHTML = '';
          if (!list.length){ results.innerHTML = '<div class="no-results">No results</div>'; return }
          for (const it of list) results.appendChild(createCard(it));

            const totalPages = Math.max(1, Math.ceil(total / pageSize));
          pager.innerHTML = '';
          const prev = document.createElement('button'); prev.textContent='Prev'; prev.disabled = currentPage <= 1; prev.addEventListener('click', ()=> renderPage(currentPage-1));
          const next = document.createElement('button'); next.textContent='Next'; next.disabled = currentPage >= totalPages; next.addEventListener('click', ()=> renderPage(currentPage+1));
          const info = document.createElement('div'); info.className='small'; info.textContent = `Page ${currentPage} of ${totalPages} — ${total} results`;
              pager.appendChild(prev); pager.appendChild(info); pager.appendChild(next);
        }catch(err){ results.innerHTML = '<div class="no-results">Search failed</div>'; pager.innerHTML=''; }
      }
    </script>
  </body>
</html>

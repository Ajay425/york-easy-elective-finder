<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title><%= title %></title>
    <style>
      :root {
        --bg: #f6f7fb;
        --card: #ffffff;
        --muted: #5b6575;
        --ink: #152033;
        --accent: #1f5ea8;
        --line: #dce6f3;
        --danger: #b42318;
        --danger-soft: #fff1f0;
      }
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: var(--bg);
        margin: 0;
        padding: 24px;
        color: var(--ink);
      }
      .container { max-width: 1180px; margin: 0 auto; }
      .top-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
      h1 { font-size: 22px; margin: 0; }
      h2 { margin: 0 0 10px; font-size: 18px; }
      .panel {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 16px;
      }
      .grid { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 10px; }
      label { display: block; font-size: 12px; color: var(--muted); font-weight: 600; }
      input, textarea {
        box-sizing: border-box;
        width: 100%;
        margin-top: 4px;
        border: 1px solid var(--line);
        border-radius: 7px;
        padding: 8px;
        font: inherit;
      }
      textarea { min-height: 90px; resize: vertical; }
      .full { grid-column: 1 / -1; }
      .btn {
        padding: 8px 10px;
        border-radius: 7px;
        border: 1px solid transparent;
        cursor: pointer;
        font-weight: 600;
      }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-danger { background: var(--danger-soft); color: var(--danger); border-color: #ffccc7; }
      .message { border: 1px solid #b7ebc6; background: #e9f9ef; color: #166534; border-radius: 8px; padding: 10px; margin-bottom: 14px; }
      .error { border: 1px solid #ffccc7; background: var(--danger-soft); color: var(--danger); border-radius: 8px; padding: 10px; margin-bottom: 14px; }
      table { width: 100%; border-collapse: collapse; }
      th, td { border-top: 1px solid var(--line); padding: 9px; text-align: left; vertical-align: top; }
      th { color: var(--muted); font-size: 12px; text-transform: uppercase; }
      .key { font-weight: 700; white-space: nowrap; }
      .muted { color: var(--muted); }
      @media (max-width: 760px) {
        .grid { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="top-row">
        <div>
          <a href="/admin">Back to search</a>
          <h1>Manual Course Lists</h1>
        </div>
        <a href="/admin/logout" style="color:#2b6cb0;text-decoration:none">Logout</a>
      </div>

      <% if (message) { %><div class="message"><%= message %></div><% } %>
      <% if (error) { %><div class="error"><%= error %></div><% } %>

      <div class="panel">
        <h2>Add Course To Step15 Hide List</h2>
        <form method="post" action="/admin/manual-lists/hidden/add">
          <div class="grid">
            <label>Faculty
              <input name="faculty" placeholder="ED" required />
            </label>
            <label>Department
              <input name="deptAcronym" placeholder="ECON" required />
            </label>
            <label>Course Code
              <input name="courseCode" placeholder="4000" required />
            </label>
            <label>Credit
              <input name="credit" placeholder="3" required />
            </label>
            <label class="full">Reason
              <input name="reason" placeholder="BEd-only, permission-only, restricted program course, etc." />
            </label>
            <label class="full">Course Description
              <textarea name="courseDescription" placeholder="Optional, but useful for remembering why this was hidden."></textarea>
            </label>
          </div>
          <div style="margin-top:10px">
            <button class="btn btn-primary" type="submit">Add To Hide List</button>
          </div>
        </form>
      </div>

      <div class="panel">
        <h2>Step15 Hidden From Frontend (<%= step15Courses.length %>)</h2>
        <% if (!step15Courses.length) { %>
          <div class="muted">No hidden courses yet.</div>
        <% } else { %>
          <table>
            <thead>
              <tr><th>Course</th><th>Reason</th><th>Description</th><th></th></tr>
            </thead>
            <tbody>
              <% step15Courses.forEach(function(course) { %>
                <tr>
                  <td class="key"><%= course.key %></td>
                  <td><%= course.reason || '—' %></td>
                  <td><%= course.courseDescription || '—' %></td>
                  <td>
                    <form method="post" action="/admin/manual-lists/hidden/remove" onsubmit="return confirm('Remove this course from Step15?');">
                      <input type="hidden" name="key" value="<%= course.key %>" />
                      <button class="btn btn-danger" type="submit">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <div class="panel">
        <h2>Step13 Force No Real Prereqs (<%= step13Courses.length %>)</h2>
        <% if (!step13Courses.length) { %>
          <div class="muted">No Step13 courses yet.</div>
        <% } else { %>
          <table>
            <thead>
              <tr><th>Course</th><th>Reason</th><th>Description</th></tr>
            </thead>
            <tbody>
              <% step13Courses.forEach(function(course) { %>
                <tr>
                  <td class="key"><%= course.key %></td>
                  <td><%= course.reason || '—' %></td>
                  <td><%= course.courseDescription || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </body>
</html>

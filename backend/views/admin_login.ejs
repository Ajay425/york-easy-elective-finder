<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Admin Login</title>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
      body{font-family:Arial, sans-serif;background:#f7f8fb;padding:24px}
      .box{max-width:420px;margin:80px auto;background:#fff;padding:20px;border-radius:10px;border:1px solid #eee}
      input{width:100%;padding:10px;margin-top:8px;border:1px solid #ddd;border-radius:6px}
      button{margin-top:12px;padding:10px 12px;border-radius:6px;background:#2b6cb0;color:#fff;border:none}
      .error{color:#b00;margin-top:8px}
    </style>
  </head>
  <body>
    <div class="box">
      <h2>Admin Login</h2>
      <form method="post" action="/admin/login">
        <label>Password</label>
        <input type="password" name="password" placeholder="Enter admin password" />
        <div style="margin-top:12px">
          <div class="cf-turnstile" data-sitekey="<%= process.env.TURNSTILE_SITE_KEY || '' %>"></div>
        </div>
        <div style="margin-top:10px">
          <button type="submit">Sign in</button>
        </div>
      </form>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
    </div>
  </body>
</html>
